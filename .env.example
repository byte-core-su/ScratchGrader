# Colab 或部署環境的設定；請複製後填入真正值，且不要提交 .env。
NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=
# 選用：啟用後，啟動器只會停止佔用上述靜態網域的舊 tunnel session。
NGROK_API_KEY=
NGROK_REMOTE_RECOVERY=true
PORT=5000
# 同時最多處理幾份 AI 評分；其餘會依送出順序排隊。15 人班級建議保留預設 3。
MAX_CONCURRENT_GRADES=3
# 等候中的評分上限；超過時 API 會回傳「排隊已滿」，請學生稍後再送出。
MAX_QUEUED_GRADES=24
# 請用長、隨機且不重複的字串；只由教師端在登入時輸入。
ADMIN_TOKEN=
# 以逗號分隔可呼叫 API 的前端來源。若以本機 HTML（file://）開啟，暫時可設為 *。
CORS_ALLOWED_ORIGINS=*

# 未設定或設為 false 時，設定與繳交紀錄只存 Colab 本機檔案。
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CONFIG_COLLECTION=scratchgrader
FIREBASE_CONFIG_DOCUMENT=config
FIREBASE_SUBMISSIONS_COLLECTION=scratchgrader_submissions
# 本機建議填服務帳戶 JSON 檔案的路徑；該檔案已被 .gitignore 排除。
FIREBASE_SERVICE_ACCOUNT_FILE=
# Colab 用：把完整 JSON 放到 Colab Secrets，不要放到這個檔案。
FIREBASE_SERVICE_ACCOUNT_JSON=
# 可替代 FIREBASE_SERVICE_ACCOUNT_FILE，使用 Google Application Default Credentials 的服務帳戶 JSON 路徑。
GOOGLE_APPLICATION_CREDENTIALS=
CONFIG_PATH=grader_config.json
